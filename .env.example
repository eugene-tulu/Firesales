# Firesales environment variables
# Copy to .env.local for the web app. Set server-side secrets in your Convex
# deployment as well; never commit a filled-in environment file.

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Convex (written by `npx convex dev` after you link a deployment)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Paystack hosted checkout. The same secret key is used to create transactions
# and verify the HMAC-SHA512 webhook signature. Kenya launch defaults to KES.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES

# Cloudflare Durable Object inventory worker. Set the same token as a Worker
# secret, then give Convex the deployed worker URL and token.
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
CLOUDFLARE_WORKER_TOKEN=

# Optional chef-source research. This is used only to fill a reviewed draft.
FIRECRAWL_API_KEY=

# Optional transactional email and monitoring
RESEND_API_KEY=
RESEND_EMAIL_SENDER=onboarding@resend.dev
# VITE_SENTRY_DSN=

# Firesales Environment Variables
# Copy this file to .env.local and fill in the values
# DO NOT COMMIT .env.local to version control

# ==========================================
# REQUIRED SECRETS
# ==========================================

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Application URL (for development)
BETTER_AUTH_URL=http://localhost:3000

# ==========================================
# DODO PAYMENTS (Payment Processor)
# ==========================================
# Get from: https://dashboard.dodopayments.com/developer
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode  # or "live_mode" for production
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/dashboard/flash-sales

# ==========================================
# CONVEX DATABASE (Auto-configured)
# ==========================================
# Run: npx convex dev to get these values
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# ==========================================
# CLOUDFLARE (AI & Inventory)
# ==========================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
CLOUDFLARE_WORKER_TOKEN=  # Token for Cloudflare Worker auth (if needed)

# ==========================================
# FIRECRAWL (Product Scraping - Optional)
# ==========================================
# Get from: https://firecrawl.com/dashboard
FIRECRAWL_API_KEY=

# ==========================================
# AUTUMN (Usage Billing - Optional)
# ==========================================
# Get from: https://useautumn.com/dashboard
AUTUMN_SECRET_KEY=
VITE_AUTUMN_50_CREDITS_ID=

# ==========================================
# AI MESSAGE LIMITS (Optional)
# ==========================================
# Number of free AI messages allowed per user (default: 10)
FREE_MESSAGE_LIMIT=10

# ==========================================
# RESEND (Email - Optional)
# ==========================================
# Get from: https://resend.com/dashboard
RESEND_API_KEY=
RESEND_EMAIL_SENDER=onboarding@resend.dev

# ==========================================
# SENTRY (Error Monitoring - Optional)
# ==========================================
# Get from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# VITE_SENTRY_DSN=
